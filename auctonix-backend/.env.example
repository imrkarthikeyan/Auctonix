# Backend runtime
PORT=8080

# Supabase Postgres (Transaction pooler is recommended for cloud deploy)
# Format: jdbc:postgresql://<host>:6543/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.<YOUR_PROJECT_REF>.supabase.co:6543/postgres?sslmode=require
DB_USERNAME=postgres.<YOUR_PROJECT_REF>
DB_PASSWORD=<YOUR_SUPABASE_DB_PASSWORD>

# Security
JWT_SECRET=<CHANGE_ME_TO_A_LONG_RANDOM_SECRET>
JWT_EXPIRATION=86400000

# Optional service URL
ML_SERVICE_BASE_URL=http://localhost:8000
